<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/fetch-at-home.sh every day at 07:30 (or on wake if the Mac was asleep).
     Install: cp scripts/com.superprecios.fetch-at-home.plist ~/Library/LaunchAgents/
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.superprecios.fetch-at-home.plist
     Remove:  launchctl bootout gui/$(id -u)/com.superprecios.fetch-at-home
              rm ~/Library/LaunchAgents/com.superprecios.fetch-at-home.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.superprecios.fetch-at-home</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jesus/SuperPrecios/scripts/fetch-at-home.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/jesus/.nvm/versions/node/v24.16.0/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/jesus/Library/Logs/superprecios-fetch-at-home.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jesus/Library/Logs/superprecios-fetch-at-home.log</string>
</dict>
</plist>
